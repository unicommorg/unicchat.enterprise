# UnicChat Enterprise - single .env for docker-compose.yml
#
# cp .env.example .env  и заполните домены.
#
# СЕКРЕТЫ: все change_me_* и типовые имена пользователей — заготовки.
# Сгенерируйте свои пароли (README §2.4). Не копируйте значения
# из документации и с других площадок.
#
# ВАЖНО: пароли подставляются в MongoDB connection strings без URL-кодирования,
# поэтому используйте только [A-Za-z0-9_-] без @ : / ? & % и пробелов.
#
# Образы (image) задаются здесь — и в docker-compose.yml, и в compose.<роль>.yml.
# На всех серверах один и тот же .env.

#### IMAGES ########
IMAGE_MONGODB=cr.yandex/crps5m51hmah43pmfb23/mongodb:4.4
IMAGE_VAULT=cr.yandex/crpi5ll6mqcn793fvu9i/unic/unicvault:prod
IMAGE_VAULT_INIT=curlimages/curl:8.8.0
IMAGE_APPSERVER=cr.yandex/crpst6ndtaf70or2n2bb/unic_chat_appserver:2.4.3
IMAGE_LOGGER=cr.yandex/crpi5ll6mqcn793fvu9i/unic/uniclogger:prod
IMAGE_TASKER=cr.yandex/crpi5ll6mqcn793fvu9i/unic/unicchatkbasetasker:prod
IMAGE_NGINX=cr.yandex/crpst6ndtaf70or2n2bb/nginx:2.4.1
IMAGE_MINIO=cr.yandex/crpst6ndtaf70or2n2bb/minio:RELEASE.2024-12-18T13-15-44Z
IMAGE_MINIO_MC=cr.yandex/crpst6ndtaf70or2n2bb/minio-mc:latest
IMAGE_DOCUMENTSERVER=cr.yandex/crpst6ndtaf70or2n2bb/uniceditor:latest
IMAGE_RABBITMQ=cr.yandex/crpst6ndtaf70or2n2bb/rabbitmq:latest
IMAGE_POSTGRES=cr.yandex/crpst6ndtaf70or2n2bb/postgres:12

#### DOMAINS ########
# Публичные DNS-имена сервисов.
APP_SERVER_NAME=app.example.com
DOCUMENTSERVER_SERVER_NAME=documentserver.example.com
MINIO_SERVER_NAME=minio.example.com

#### MONGODB ########
MONGODB_REPLICA_SET_MODE=primary
MONGODB_REPLICA_SET_NAME=rs01
MONGODB_REPLICA_SET_KEY=rs0key
MONGODB_PORT_NUMBER=27017
MONGODB_HOST=unicchat-mongodb
MONGODB_ADVERTISED_HOSTNAME=unicchat-mongodb
MONGODB_ENABLE_JOURNAL=true
MONGODB_ROOT_PASSWORD=change_me_root
MONGODB_USERNAME=unicchat_admin
MONGODB_PASSWORD=change_me_app
MONGODB_DATABASE=unicchat_db

##### AppServer ######
DB_COLLECTIONS_PREFIX=unicchat_
# Tasker. Один сервер: http://unicchat-tasker:8080
# Отдельный сервер Tasker: http://<tasker-host>:8080
UNIC_SOLID_HOST=http://unicchat-tasker:8080
# Отдельный сервер Tasker публикует 8881 на хосте: http://<tasker-host>:8881
PORT=3000
DEPLOY_METHOD=docker
ROOT_URL=https://${APP_SERVER_NAME}
# Push/License gateway
LICENSE_HOST=https://push1.unic.chat/

### Vault ######
VAULT_DB_USER=vault_user
VAULT_DB_PASSWORD=change_me_vault
VAULT_DB_NAME=vault_db
API_VAULT_URL=http://unicchat-vault/
# На сервере Tasker при разнесении: http://<vault-host>:8200/

### Logger ######
LOGGER_DB_USER=logger_user
LOGGER_DB_PASSWORD=change_me_logger
LOGGER_DB=logger_db
API_LOGGER_URL=http://unicchat-logger:8080/
# Отдельный сервер Logger публикует 8082 на хосте: http://<logger-host>:8082/

### Tasker ######
TASKER_DB_USER=tasker_user
TASKER_DB_PASSWORD=change_me_tasker
TASKER_DB_NAME=tasker_db
# Адрес MinIO host:port для секрета KBTConfigs (без схемы).
# Один сервер: unicchat-minio:9000
# MinIO на другом сервере: <minio-host>:9000
KBT_MINIO_HOST=unicchat-minio:9000
# Хост MongoDB в MongoCS секрета KBTConfigs.
# Один сервер: unicchat-mongodb
# MongoDB на другом сервере: <mongodb-host>
KBT_MONGO_HOST=unicchat-mongodb

### Nginx ######
# Один сервер: имя контейнера. Отдельный сервер: <appserver-host>
UNICCHAT_HOST=unicchat-appserver
# Порт upstream для nginx. Один сервер — не задавать (берётся PORT=3000).
# Отдельный сервер AppServer публикует 8080 на хосте: NGINX_APP_PORT=8080
# NGINX_APP_PORT=
SSL_CERT=/certs/config/live/app.example.com/fullchain.pem
SSL_KEY=/certs/config/live/app.example.com/privkey.pem
DOCUMENTSERVER_PROXY_ENABLE=true
# Один сервер: имя контейнера (порт 80 внутри сети).
# Отдельный сервер Knowledgebase публикует 8880: <kb-host>:8880
DOCUMENT_SERVER_PROXY=unicchat-documentserver
DOCUMENTSERVER_SSL_CERT=/certs/config/live/documentserver.example.com/fullchain.pem
DOCUMENTSERVER_SSL_KEY=/certs/config/live/documentserver.example.com/privkey.pem
MINIO_PROXY_ENABLE=true
# Upstream hostname для встроенного nginx (без порта). Не путать с KBT_MINIO_HOST.
MINIO_HOST=unicchat-minio
MINIO_PORT=9000
MINIO_SSL_CERT=/certs/config/live/minio.example.com/fullchain.pem
MINIO_SSL_KEY=/certs/config/live/minio.example.com/privkey.pem
# Альтернатива файлам в ./certs - сертификаты одной строкой в base64:
# SSL_CERTIFICATE_FILE_IN_BASE64=
# SSL_CERTIFICATE_KEY_FILE_IN_BASE64=

### Minio ######
MINIO_ROOT_USER=minio_unicchat
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BROWSER=on
MINIO_BUCKET=unicchat-files
MINIO_DOCS_BUCKET=uc.onlyoffice.docs

### Document_server ######
JWT_ENABLED=false
JWT_SECRET=
JWT_HEADER=Authorization
DB_TYPE=postgres
DB_HOST=unicchat-postgresql
DB_PORT=5432
DB_NAME=documentserver_db
DB_USER=documentserver_user
AMQP_URI=amqp://guest:guest@unicchat-rabbitmq
ALLOW_PRIVATE_IP_ADDRESS=true
